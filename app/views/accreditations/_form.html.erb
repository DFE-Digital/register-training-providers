
<%= content_for(:breadcrumbs) do %>
  <%= render GovukComponent::BackLinkComponent.new(
        text: "Back",
        href: back_path,
      ) %>
<% end %>

<%= form_for @form, url: form_url, method: form_method do |form| %>
  <% page_data(title: page_title, header: false, error: @form.errors.present?) %>

  <%= content_for(:page_alerts) { form.govuk_error_summary } %>
  <%= form.govuk_fieldset legend: { text: "" }, caption: { text: caption } do %>
    <%= form.govuk_text_field :number, label: { text: "What is the accreditation number?", size: "l", tag: "h1" }, width: "one-quarter", hint: { text: accreditation_number_hint_text(provider_type) } %>
  <% end %>
  <%= form.govuk_submit %>

<% end %>

<p class="govuk-body">
  <%= govuk_link_to("Cancel", cancel_path) %>
</p>
