
<%= content_for(:breadcrumbs) do %>
  <%= render GovukComponent::BackLinkComponent.new(
        text: "Back",
        href: back_path,
      ) %>
<% end %>

<%= form_for @form, url: form_url, method: form_method do |form| %>
  <% page_data(title: page_title, header: false, error: @form.errors.present?) %>

  <%= content_for(:page_alerts) { form.govuk_error_summary } %>
  <%= form.govuk_fieldset legend: { text: nil }, caption: { text: caption } do %>
  <%= form.govuk_radio_buttons_fieldset(:end_date_required, inline: false, legend: { size: "l", text: "Does the accreditation have an end date?", tag: "h1" }) do %>
  <%= form.govuk_radio_button(
        :end_date_required,
        true,
        label: { text: "Yes" },
      ) %>
  <%= form.govuk_radio_button(
        :end_date_required,
        false,
        label: { text: "No" },
      ) %>
<% end %>
  <% end %>
  <%= form.govuk_submit %>

<% end %>

<p class="govuk-body">
  <%= govuk_link_to("Cancel", cancel_path) %>
</p>
