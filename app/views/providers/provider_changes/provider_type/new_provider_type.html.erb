<%= content_for(:breadcrumbs) do %>
  <%= render GovukComponent::BackLinkComponent.new(
        text: "Back",
        href: @wizard.previous_step_path,
      ) %>
<% end %>

<%= form_for(
      @wizard.current_step,
      as: @wizard.current_step.step_id,
      url: @wizard.current_step_path(return_to_review: params[:return_to_review]),
      method: :patch
    ) do |form| %>

  <% page_data(
       title: @provider.operating_name,
       subtitle: "What should the provider type change to?",
       header: false,
       error: @wizard.current_step.errors.present?
     ) %>

  <%= content_for(:page_alerts) { form.govuk_error_summary } %>

  <%= form.govuk_radio_buttons_fieldset(
        :provider_type,
        legend: { text: "What should the provider type change to?" },
        caption: { text: @provider.operating_name }
      ) do %>
    <% ProviderTypeEnum::PROVIDER_TYPES.keys.each_with_index do |type, index| %>
      <%= form.govuk_radio_button :provider_type, type,
                                  label: { text: ProviderTypeEnum.label_for(type) },
                                  link_errors: index.zero? %>
    <% end %>
  <% end %>

  <%= form.govuk_submit %>

<% end %>

<p class="govuk-body">
  <%= govuk_link_to("Cancel", provider_path(@provider)) %>
</p>
