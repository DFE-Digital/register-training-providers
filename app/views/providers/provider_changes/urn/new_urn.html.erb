<%= content_for(:breadcrumbs) do %>
  <%= render GovukComponent::BackLinkComponent.new(
        text: "Back",
        href: @wizard.previous_step_path,
      ) %>
<% end %>

<%= form_for(
      @wizard.current_step,
      as: @wizard.current_step.step_id,
      url: @wizard.current_step_path(return_to_review: params[:return_to_review]),
      method: :patch
    ) do |form| %>

  <% page_data(
       title: @provider.operating_name,
       subtitle: "What should the unique reference number (URN) change to?",
       header: false,
       error: @wizard.current_step.errors.present?
     ) %>

  <%= content_for(:page_alerts) { form.govuk_error_summary } %>

  <%= form.govuk_fieldset legend:
        { text: "What should the unique reference number (URN) change to?" }, caption: { text: @provider.operating_name } do %>

    <%= form.govuk_text_field :urn, width: "one-quarter",
                                    label: { size: "s", text: "Unique reference number (URN)#{" (optional)" unless @provider.requires_urn?}" },
                                    hint: {
                                      text: "A unique 5 or 6 digit number used by the UK government to identify educational establishments in the United Kingdom"
                                    } %>
  <% end %>

  <%= form.govuk_submit %>

<% end %>

<p class="govuk-body">
  <%= govuk_link_to("Cancel", provider_path(@provider)) %>
</p>
