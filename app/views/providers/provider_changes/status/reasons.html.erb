<%= content_for(:breadcrumbs) do %>
  <%= render GovukComponent::BackLinkComponent.new(
        text: "Back",
        href: @wizard.previous_step_path(fallback: provider_path(@provider)),
      ) %>
<% end %>

<%= form_for(
      @wizard.current_step,
      as: @wizard.current_step.step_id,
      url: @wizard.current_step_path(return_to_review: params[:return_to_review]),
      method: :patch
    ) do |form| %>

  <% page_data(
       title: @provider.operating_name,
       subtitle: status_reason_legend(@wizard.state_store.read.with_indifferent_access["new_status"]),
       header: false,
       error: @wizard.current_step.errors.present?
     ) %>

  <%= content_for(:page_alerts) { form.govuk_error_summary } %>

  <%= form.govuk_check_boxes_fieldset :reasons,
                                      legend: {
                                        text: status_reason_legend(
                                          @wizard.state_store.read.with_indifferent_access["new_status"]
                                        )
                                      },
                                      caption: { text: @provider.operating_name } do %>
    <% @wizard.current_step.reasons_for_inactive.each_with_index do |reason, index| %>
      <%= form.govuk_check_box :reasons, reason.id,
                               label: { text: reason.name },
                               checked: @wizard.current_step.reasons.include?(reason.id),
                               link_errors: index.zero? %>
    <% end %>

    <%= form.govuk_check_box :reasons, :other,
                             label: { text: "Another reason" },
                             checked: @wizard.current_step.other_reason_selected? do %>
      <%= form.govuk_text_area :other_reason,
                               label: { text: "Enter the reason" },
                               hint: { text: "Any other reason not listed" },
                               value: @wizard.current_step.other_reason_text,
                               maxlength: 255 %>
    <% end %>
  <% end %>

  <%= form.govuk_submit %>
<% end %>

<p class="govuk-body">
  <%= govuk_link_to("Cancel", provider_path(@provider)) %>
</p>
