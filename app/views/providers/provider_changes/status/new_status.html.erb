<%= content_for(:breadcrumbs) do %>
  <%= render GovukComponent::BackLinkComponent.new(
        text: "Back",
        href: @wizard.previous_step_path(fallback: provider_path(@provider)),
      ) %>
<% end %>

<%= form_for(
      @wizard.current_step,
      as: @wizard.current_step.step_id,
      url: @wizard.current_step_path(return_to_review: params[:return_to_review]),
      method: :patch
    ) do |form| %>

  <% page_data(
       title: @provider.operating_name,
       subtitle: "What is the new provider status?",
       header: false,
       error: @wizard.current_step.errors.present?
     ) %>

  <%= content_for(:page_alerts) { form.govuk_error_summary } %>

  <%= form.govuk_radio_buttons_fieldset :new_status,
                                        legend: { text: "What is the new provider status?" },
                                        caption: { text: @provider.operating_name } do %>
    <% @wizard.current_step.statuses.each do |status| %>
      <%= form.govuk_radio_button :new_status, status.value,
                                  label: { text: status.label },
                                  link_errors: status == @wizard.current_step.statuses.first %>
    <% end %>
  <% end %>

  <%= form.govuk_submit %>
<% end %>

<p class="govuk-body">
  <%= govuk_link_to("Cancel", provider_path(@provider)) %>
</p>
