<%= content_for(:breadcrumbs) do %>
  <%= render GovukComponent::BackLinkComponent.new(
        text: "Back",
        href: @wizard.previous_step_path,
      ) %>
<% end %>

<%= form_for(
      @wizard.current_step,
      as: @wizard.current_step.step_id,
      url: @wizard.current_step_path(return_to_review: params[:return_to_review]),
      method: :patch
    ) do |form| %>

  <% page_data(
       title: @provider.operating_name,
       subtitle: "What should the UK provider reference number change to?",
       header: false,
       error: @wizard.current_step.errors.present?
     ) %>

  <%= content_for(:page_alerts) { form.govuk_error_summary } %>

  <%= form.govuk_fieldset legend:
        { text: "What should the UK provider reference number change to?" }, caption: { text: @provider.operating_name } do %>

    <%= form.govuk_text_field :ukprn, width: "one-quarter", label: { size: "s", text: "UK provider reference number (UKPRN)" },
                                      hint: {
                                        text: "A unique 8 digit number allocated to providers by the UK register of learning providers"
                                      } %>
  <% end %>

  <%= form.govuk_submit %>

<% end %>

<p class="govuk-body">
  <%= govuk_link_to("Cancel", provider_path(@provider)) %>
</p>
