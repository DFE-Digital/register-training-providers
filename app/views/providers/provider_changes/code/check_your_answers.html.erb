<%= content_for(:breadcrumbs) do %>
  <%= render GovukComponent::BackLinkComponent.new(
        text: "Back",
        href: @wizard.previous_step_path,
      ) %>
<% end %>

<%= form_for(
      @wizard.current_step,
      as: @wizard.current_step.step_id,
      url: @wizard.current_step_path,
      method: :patch
    ) do |form| %>

  <% page_data(
       title: @provider.operating_name,
       subtitle: "Check your answers",
       header: false,
       error: @wizard.current_step.errors.present?
     ) %>
  <%= form.govuk_fieldset legend: { text: "Check your answers" },
                          caption: { text: @provider.operating_name } do %>
    <br>

    <%= govuk_summary_list(rows: @review.rows) %>

    <p class="govuk-body">
      Confirm this information is correct before sending the request to change the provider code.
    </p>
    <br>

    <%= form.govuk_submit("Confirm and continue") %>
  <% end %>
<% end %>

<p class="govuk-body">
  <%= govuk_link_to("Cancel", providers_path) %>
</p>
