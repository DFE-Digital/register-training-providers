<%= content_for(:breadcrumbs) do %>
  <%= render GovukComponent::BackLinkComponent.new(
        text: "Back",
        href: @wizard.previous_step_path(fallback: provider_path(@provider)),
      ) %>
<% end %>

<%= form_for(
      @wizard.current_step,
      as: @wizard.current_step.step_id,
      url: @wizard.current_step_path(return_to_review: params[:return_to_review]),
      method: :patch
    ) do |form| %>

  <% page_data(
       title: @provider.operating_name,
       subtitle: "When should the provider code change?",
       header: false,
       error: @wizard.current_step.errors.present?
     ) %>

  <%= content_for(:page_alerts) { form.govuk_error_summary } %>

  <%= form.govuk_radio_buttons_fieldset(
        :effective_on,
        legend: { text: "When should the provider code change?" },
        caption: { text: @provider.operating_name }
      ) do %>

    <%= form.govuk_radio_button(
          :effective_on,
          @wizard.current_step.next_academic_year_start_date,
          label: { text: @wizard.current_step.next_academic_year_label },
          link_errors: true
        ) %>

    <%= form.govuk_radio_button(
          :effective_on,
          @wizard.current_step.following_academic_year_start_date,
          label: { text: @wizard.current_step.following_academic_year_label }
        ) %>

  <% end %>

  <%= form.govuk_submit %>
<% end %>

<p class="govuk-body">
  <%= govuk_link_to("Cancel", provider_path(@provider)) %>
</p>
