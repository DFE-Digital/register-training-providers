<%= content_for(:breadcrumbs) do %>
  <%= render GovukComponent::BackLinkComponent.new(
        text: "Back",
        href: back_path,
      ) %>
<% end %>

<%= form_for @form, url: new_provider_is_the_provider_accredited_path do |form| %>
  <% page_data(title: @form.accreditation_status_question_for(current_user), subtitle: "Add provider", header: false, error: @form.errors.present?) %>

  <%= content_for(:page_alerts) { form.govuk_error_summary } %>

  <%= form.govuk_fieldset legend: { text: @form.accreditation_status_question_for(current_user) }, caption: { text: "Add provider" } do %>
    <% if @form.single_accreditation_status_for(current_user) %>
      <%= form.hidden_field :accreditation_status, value: @form.single_accreditation_status_for(current_user).key %>

      <p class="govuk-body">
        Your role can only add
        <%= @form.single_accreditation_status_for(current_user).key.to_s == AccreditationStatusEnum::ACCREDITED ? "accredited" : "unaccredited" %>
        providers.
      </p>
    <% else %>
      <%= form.govuk_collection_radio_buttons(:accreditation_status, @form.accreditation_status_options_for_radios(current_user),
                                              :key,
                                              :value, legend: nil) %>
    <% end %>

    <%= form.govuk_submit %>
  <% end %>
<% end %>

<p class="govuk-body">
  <%= govuk_link_to("Cancel", providers_path) %>
</p>
