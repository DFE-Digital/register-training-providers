<%= content_for(:breadcrumbs) do %>
  <%= govuk_back_link(text: "Back", href: @back_path) %>
<% end %>

<% page_data(title: @page_title, subtitle: @page_subtitle, caption: @page_caption) %>

<p class="govuk-body"><%= @ending_message %></p>

<%= govuk_button_to(@confirm_label, @confirm_path) %>

<p class="govuk-body">
  <%= govuk_link_to("Cancel", @cancel_path) %>
</p>
