<%= content_for(:breadcrumbs) do %>
    <%= govuk_back_link(text: "Back", href: @back_path) %>
<% end %>

<% page_data(title: @page_title, subtitle: @page_subtitle, caption: @page_caption) %>

<p class="govuk-body">
  Deleting this partnership will permanently remove it from the provider record.
  It may still be retained for audit purposes.
</p>

<% if @partnership.can_be_ended? %>
  <p class="govuk-body">
    Only delete a partnership if the record was created incorrectly. If the partnership has ended, use
    <%= govuk_link_to "End partnership", provider_partnership_end_path(@partnership, provider_id: provider.id) %>
    instead.
  </p>
<% end %>

<%= govuk_warning_text(text: "You cannot undo this action.") %>

<%= govuk_button_to("Delete partnership", @delete_path, method: :delete, warning: true) %>

<p class="govuk-body">
  <%= govuk_link_to("Cancel", @cancel_path) %>
</p>
