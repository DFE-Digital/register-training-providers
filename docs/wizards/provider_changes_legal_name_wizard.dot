digraph Provider_changes_legal_name_wizard {
  rankdir=LR;
  bgcolor="#ffffff";
  node [shape=box, style="rounded,filled", fillcolor="#e8f4f8", fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=10];
  effective_date [label="Effective Date"];
  new_legal_name [label="New Legal Name"];
  check_your_answers [label="Check Your Answers"];
  effective_date -> new_legal_name [style=solid];
  new_legal_name -> check_your_answers [style=solid];
}